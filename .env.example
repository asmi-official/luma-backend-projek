DB_HOST=localhost
DB_PORT=5432
DB_NAME=asmi_dev
DB_USER=postgres
DB_PASSWORD=baus@12345

PATH_FILE_UPLOAD= files

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

PORT=4000
BASE_URL=http://localhost:4000

# NODE_ENV menentukan apakah struktur tabel diubah otomatis saat server start.
#
#   development  → sync({ alter: true }) jalan otomatis.
#                  cocok untuk coding lokal: ubah model, restart, tabel ikut berubah.
#
#   production   → auto-sync DIMATIKAN. struktur tabel HANYA berubah lewat:
#                      npm run migrate
#                  ganti ke production saat deploy ke server beneran.
#
# kenapa production tidak boleh auto-sync:
#   - alter bisa MENGHAPUS kolom yang hilang dari model → data hilang permanen
#   - kalau alter gagal, server ikut mati (API down, bukan cuma skema gagal)
#   - tidak ada jejak perubahan & tidak bisa di-rollback
#
# nilai lain (staging, test, dll) juga otomatis mematikan auto-sync,
# karena hanya 'development' yang menyalakannya
NODE_ENV=development

# paksa on/off auto-sync, menimpa NODE_ENV di atas.
# JANGAN diisi true di production: alter bisa menghapus kolom & tidak bisa di-rollback
# DB_SYNC_ALTER=false
# kunci AES-256-GCM untuk enkripsi credential payment gateway (hex 64 karakter)
# generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# base url midtrans
# sandbox    : https://api.sandbox.midtrans.com
# production : https://api.midtrans.com
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com