            "description": "List semua promo dengan pagination.\n\nQuery params opsional:\n- `page` (default 1)\n- `limit` (default 10, max 100)\n- `sort` (nama kolom, misal `created_at`)\n- `order` (`asc` / `desc`)\n- `filter` (JSON array, misal `[{\"key\":\"discount_type\",\"operator\":\"equal\",\"value\":\"percentage\"}]`)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('List promo berhasil', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.meta).to.have.property('total');",
