            "description": "Buat promo tipe **Harga Spesial**.\n\n- `special_price`: harga tetap khusus yang langsung ditetapkan\n- `discount_value`: diset 0 (tidak relevan)\n- `usage_limit`: null = tidak terbatas"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Promo harga spesial berhasil dibuat', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data.discount_type).to.eql('special_price');",
                  "    pm.expect(Number(json.data.special_price)).to.eql(99000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
